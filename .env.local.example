# Frontend
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_ENABLE_DEV_AUTH=
SITE_URL=http://localhost:3000
# CONVEX_SITE_URL is injected by Convex at runtime. Do not set it manually.

# Convex Auth (GitHub OAuth App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# M2 local employee directory + Feishu SSO. Keep both flags at 0 for the M1
# GitHub-only fallback. When the directory flag is 1, only explicitly bound,
# active employee records can create sessions through either provider.
# Keep all secrets and the designated-admin email in the Convex deployment
# environment, never in Git. CONVEX_SITE_URL is injected by Convex.
AUTH_EMPLOYEE_DIRECTORY_ENABLED=0
AUTH_EMPLOYEE_BOOTSTRAP_ADMIN_EMAIL=
AUTH_FEISHU_ENABLED=0
AUTH_FEISHU_APP_ID=
AUTH_FEISHU_APP_SECRET=

# Convex Auth JWT keys (generated via @convex-dev/auth CLI)
JWT_PRIVATE_KEY=
JWKS=

# Local dev personas (keep disabled while AUTH_EMPLOYEE_DIRECTORY_ENABLED=1)
DEV_AUTH_ENABLED=
DEV_AUTH_CONVEX_DEPLOYMENT=
DEV_AUTH_SITE_URL=
DEV_AUTH_SECRET=

# Embeddings
OPENAI_API_KEY=

# Transactional email
RESEND_API_KEY=
CLAWHUB_SECURITY_EMAIL_FROM=ClawHub Security <noreply@notifications.openclaw.ai>
CLAWHUB_NOREPLY_FROM=ClawHub <noreply@notifications.openclaw.ai>
