# Frontend
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_ENABLE_DEV_AUTH=
SITE_URL=http://localhost:3000
# CONVEX_SITE_URL is injected by Convex at runtime. Do not set it manually.

# Convex Auth (GitHub OAuth App)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# M2 direct Feishu SSO. Enable only after Feishu security settings allow the
# derived callback URL: ${CONVEX_SITE_URL}/api/m2-auth/feishu/callback.
# Keep the App Secret in the Convex deployment environment, never in Git.
# CONVEX_SITE_URL is a reserved Convex variable; do not add it through `convex env set`.
# The browser completion URL uses SITE_URL.
AUTH_FEISHU_ENABLED=0
AUTH_FEISHU_APP_ID=
AUTH_FEISHU_APP_SECRET=
AUTH_FEISHU_ADMIN_OPEN_ID=

# Convex Auth JWT keys (generated via @convex-dev/auth CLI)
JWT_PRIVATE_KEY=
JWKS=

# Local dev personas
DEV_AUTH_ENABLED=
DEV_AUTH_CONVEX_DEPLOYMENT=
DEV_AUTH_SITE_URL=
DEV_AUTH_SECRET=

# Embeddings
OPENAI_API_KEY=

# Transactional email
RESEND_API_KEY=
CLAWHUB_SECURITY_EMAIL_FROM=ClawHub Security <noreply@notifications.openclaw.ai>
CLAWHUB_NOREPLY_FROM=ClawHub <noreply@notifications.openclaw.ai>
